{
  "sila_server": {
    "hostname": "127.0.0.2",
    "port": 50051,
    "tls": false,
    "require_client_auth": false,
    "root_certificates": null,
    "certificate_chain": null,
    "private_key": null,
    "options": {},
    "uuid": "b3a6b8de-6ec4-46e3-bb85-e43fb7bd18b4",
    "name": "Opentrons OT-2",
    "type": "LiquidHandler",
    "description": "SiLA2 connector for Opentrons OT-2 motion and GPIO control",
    "version": "0.1",
    "vendor_url": "https://opentrons.com/",
    "default_lifetime": 3600.0
  },
  "discovery": {
    "ip_version": "ipv4",
    "network_interfaces": []
  },
  "logging": {
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
      "simple": {
        "format": "%(asctime)s %(levelname)s %(name)s: %(message)s"
      }
    },
    "handlers": {
      "stderr": {
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stderr",
        "formatter": "simple"
      }
    },
    "root": {
      "level": "INFO",
      "handlers": [
        "stderr"
      ]
    }
  },
  "use_simulator": true,
  "serial_port": "/dev/ttyAMA0",
  "with_robot_server": true,
  "robot_server_uds": "/run/aiohttp.sock",
  "lock_timeout_s": null,
  "robot_server_tcp_port": 31951
}
